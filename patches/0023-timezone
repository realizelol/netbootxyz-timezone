#!/bin/sh

timezone_setup()
{
    tz=""

    for arg in $(cat /proc/cmdline); do
        case "$arg" in
            timezone=*)
                tz="${arg#timezone=}"
                ;;
        esac
    done

    [ -n "$tz" ] || return 0

    case "$tz" in
        /*|*..*|*" "*)
            echo "timezone: invalid timezone: $tz" >&2
            return 0
            ;;
    esac

    if [ ! -f "/root/usr/share/zoneinfo/$tz" ]; then
        echo "timezone: unknown timezone: $tz" >&2
        return 0
    fi

    echo "timezone: setting timezone to $tz"

    rm -f /root/etc/localtime

    ln -s \
        "/usr/share/zoneinfo/$tz" \
        /root/etc/localtime

    printf '%s\n' "$tz" > /root/etc/timezone
}
