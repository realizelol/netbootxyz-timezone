#!/bin/sh

PREREQ=""

prereqs()
{
    echo "$PREREQ"
}

case "$1" in
    prereqs)
        prereqs
        exit 0
        ;;
esac


# ============================================================
# Read timezone= from kernel command line
# ============================================================

tz=""

for arg in $(cat /proc/cmdline); do
    case "$arg" in
        timezone=*)
            tz="${arg#timezone=}"
            ;;
    esac
done


# No timezone parameter -> do nothing
[ -n "$tz" ] || exit 0


# ============================================================
# Basic validation
# ============================================================

case "$tz" in
    /*|*..*|*" "*)
        echo "timezone: invalid timezone: $tz" >&2
        exit 0
        ;;
esac


# ============================================================
# Determine live root
# ============================================================

if [ -n "${rootmnt:-}" ] && [ -d "$rootmnt" ]; then
    TARGET_ROOT="$rootmnt"
elif [ -d /root/etc ] && [ -d /root/usr/share/zoneinfo ]; then
    TARGET_ROOT="/root"
else
    echo "timezone: live root not available" >&2
    exit 0
fi


# ============================================================
# Check timezone
# ============================================================

if [ ! -f "$TARGET_ROOT/usr/share/zoneinfo/$tz" ]; then
    echo "timezone: unknown timezone: $tz" >&2
    exit 0
fi


# ============================================================
# Set timezone
# ============================================================

echo "timezone: setting timezone to $tz"

rm -f "$TARGET_ROOT/etc/localtime"

ln -s \
    "/usr/share/zoneinfo/$tz" \
    "$TARGET_ROOT/etc/localtime"

printf '%s\n' "$tz" > "$TARGET_ROOT/etc/timezone"


echo "timezone: successfully set $tz"

exit 0
