#!/bin/sh

PREREQ=""

prereqs()
{
    echo "$PREREQ"
}

case "$1" in
    prereqs)
        prereqs
        exit 0
        ;;
esac


# ============================================================
# Read timezone from kernel command line
# ============================================================

tz=""

for arg in $(cat /proc/cmdline); do
    case "$arg" in
        timezone=*)
            tz="${arg#timezone=}"
            ;;
    esac
done


# Kein timezone= Parameter -> nichts verändern
if [ -z "$tz" ]; then
    exit 0
fi


# ============================================================
# Basic validation
# ============================================================

case "$tz" in
    /*|*..*|*" "*)
        echo "timezone: invalid value: $tz" >&2
        exit 0
        ;;
esac


# ============================================================
# Check timezone
# ============================================================

if [ ! -f "/root/usr/share/zoneinfo/$tz" ]; then
    echo "timezone: unknown timezone: $tz" >&2
    exit 0
fi


# ============================================================
# Set timezone in Live filesystem
# ============================================================

echo "timezone: setting timezone to $tz"

rm -f /root/etc/localtime

ln -s \
    "/usr/share/zoneinfo/$tz" \
    /root/etc/localtime

printf '%s\n' "$tz" > /root/etc/timezone

exit 0
